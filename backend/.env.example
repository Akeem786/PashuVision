# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Initial Admin Account Setup (Optional)
# If provided, an initial admin user will be created if no admin with this email exists.
# Do NOT commit actual production passwords to version control.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Admin

# Database Configuration (Optional Supabase setup)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
